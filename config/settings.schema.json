{
  "$defs": {
    "Environment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "local",
            "int",
            "prod"
          ],
          "title": "Kind",
          "type": "string"
        },
        "jenkins_url": {
          "title": "Jenkins Url",
          "type": "string"
        },
        "portal_url": {
          "title": "Portal Url",
          "type": "string"
        },
        "manifest_url": {
          "title": "Manifest Url",
          "type": "string"
        },
        "seed_job": {
          "default": "gretl-datenportal-seed",
          "title": "Seed Job",
          "type": "string"
        },
        "username_env": {
          "default": "DATENPORTAL_JENKINS_USER",
          "title": "Username Env",
          "type": "string"
        },
        "token_env": {
          "default": "DATENPORTAL_JENKINS_TOKEN",
          "title": "Token Env",
          "type": "string"
        },
        "git_remote": {
          "default": "origin",
          "title": "Git Remote",
          "type": "string"
        },
        "git_branch": {
          "default": "main",
          "title": "Git Branch",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "repository_mode": {
          "default": "managed-git",
          "enum": [
            "working-tree",
            "managed-git"
          ],
          "title": "Repository Mode",
          "type": "string"
        },
        "git_write_back": {
          "default": false,
          "title": "Git Write Back",
          "type": "boolean"
        },
        "reload_portal": {
          "default": true,
          "title": "Reload Portal",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "jenkins_url",
        "portal_url",
        "manifest_url"
      ],
      "title": "Environment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "topics_repo": {
      "format": "path",
      "title": "Topics Repo",
      "type": "string"
    },
    "stack_repo": {
      "format": "path",
      "title": "Stack Repo",
      "type": "string"
    },
    "state_dir": {
      "default": ".datenportal-integrator/runs",
      "format": "path",
      "title": "State Dir",
      "type": "string"
    },
    "datasheet_mcp_url": {
      "default": "http://127.0.0.1:8000/mcp",
      "title": "Datasheet Mcp Url",
      "type": "string"
    },
    "validator_command": {
      "items": {
        "type": "string"
      },
      "title": "Validator Command",
      "type": "array"
    },
    "model_dirs": {
      "items": {
        "type": "string"
      },
      "title": "Model Dirs",
      "type": "array"
    },
    "compose_files": {
      "items": {
        "type": "string"
      },
      "title": "Compose Files",
      "type": "array"
    },
    "stack_start_args": {
      "items": {
        "type": "string"
      },
      "title": "Stack Start Args",
      "type": "array"
    },
    "environments": {
      "additionalProperties": {
        "$ref": "#/$defs/Environment"
      },
      "title": "Environments",
      "type": "object"
    },
    "timeout_seconds": {
      "default": 300,
      "maximum": 7200,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "root": {
      "default": ".",
      "format": "path",
      "title": "Root",
      "type": "string"
    }
  },
  "required": [
    "topics_repo",
    "stack_repo"
  ],
  "title": "Settings",
  "type": "object"
}