{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Datenportal-Integrator lokale Konfiguration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topics_repo",
    "datasheet"
  ],
  "properties": {
    "root": {
      "type": "string",
      "default": ".."
    },
    "topics_repo": {
      "type": "string"
    },
    "stack_repo": {
      "type": "string"
    },
    "state_dir": {
      "type": "string",
      "default": ".datenportal-integrator/runs"
    },
    "validator_command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "model_dirs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Zusätzliche freigegebene Eingangsverzeichnisse für den Java-Prozess; relative Pfade beziehen sich auf root. Nach Änderungen MCP-Verbindungen neu starten."
    },
    "compose_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stack_start_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200,
      "default": 300
    },
    "interlis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "enum": [
            "stdio"
          ],
          "default": "stdio"
        }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/environment"
      }
    },
    "datasheet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "enum": [
            "stdio"
          ],
          "default": "stdio"
        }
      }
    },
    "stack_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200,
      "default": 1800
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "jenkins_url",
        "portal_url",
        "manifest_url"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local",
            "int",
            "prod"
          ]
        },
        "jenkins_url": {
          "type": "string",
          "format": "uri"
        },
        "portal_url": {
          "type": "string",
          "format": "uri"
        },
        "manifest_url": {
          "type": "string",
          "format": "uri"
        },
        "seed_job": {
          "type": "string",
          "default": "gretl-datenportal-seed"
        },
        "username_env": {
          "type": "string",
          "default": "DATENPORTAL_JENKINS_USER"
        },
        "token_env": {
          "type": "string",
          "default": "DATENPORTAL_JENKINS_TOKEN"
        },
        "git_remote": {
          "type": "string",
          "default": "origin"
        },
        "git_branch": {
          "type": "string",
          "default": "main"
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "repository_mode": {
          "enum": [
            "working-tree",
            "managed-git"
          ],
          "default": "managed-git"
        },
        "git_write_back": {
          "type": "boolean",
          "default": false
        },
        "reload_portal": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "enum": [
            "stdio",
            "http"
          ],
          "default": "stdio"
        },
        "image": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "managed": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "http"
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          },
          "else": {
            "required": [
              "image"
            ],
            "not": {
              "required": [
                "url"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "managed": {
                "const": true
              }
            },
            "required": [
              "managed"
            ]
          },
          "then": {
            "required": [
              "image",
              "url",
              "transport"
            ],
            "properties": {
              "transport": {
                "const": "http"
              },
              "url": {
                "pattern": "^http://(127\\.0\\.0\\.1|localhost):[0-9]+/mcp$"
              }
            }
          }
        }
      ]
    }
  }
}
