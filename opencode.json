{
  "$schema" : "https://opencode.ai/config.json",
  "mcp" : {
    "servers" : {
      "datenportal_integrator" : {
        "command" : [ "bin/datenportal-agent", "--runtime", "docker", "--config", "config/local.toml", "serve" ],
        "disabled" : false,
        "environment" : {
          "DATENPORTAL_FORWARD_ENV" : "DATENPORTAL_LOCAL_USER DATENPORTAL_LOCAL_TOKEN"
        },
        "timeout" : {
          "catalog" : 1800000,
          "execution" : 1800000,
          "startup" : 180000
        },
        "type" : "local"
      }
    }
  }
}